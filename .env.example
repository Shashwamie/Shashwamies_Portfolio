# Copy this file to .env and fill in real values for local development.
# .env is only read by config/settings/dev.py and config/settings/base.py
# (via python-dotenv); it is git-ignored.

SECRET_KEY=change-me-to-a-random-secret-key

# Production only (config/settings/production.py) — leave unset locally.
# DEBUG defaults to False in production.
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com
# DATABASE_URL=postgres://user:password@host:5432/dbname
# SECURE_SSL_REDIRECT=true
